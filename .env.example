# GoodKit Environment Variables
# Copy to .env and fill in all values before deploying

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...         # Required — server crashes without this
STRIPE_PUBLISHABLE_KEY=pk_live_...    # Used in frontend checkout
STRIPE_WEBHOOK_SECRET=whsec_...       # From Stripe dashboard > Webhooks

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                 # Required for all transactional email
FROM_EMAIL=marketplace@good-kit.com  # Must be verified in Resend dashboard
NOTIFY_EMAIL=marketplace@good-kit.com # Admin notification address

# ── Shipping (Shippo) ─────────────────────────────────────────────────────────
SHIPPO_API_KEY=shippo_live_...        # Label generation

# ── Photo Storage (Cloudflare R2) ─────────────────────────────────────────────
R2_ENABLED=true                       # Set false to disable R2 backups
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=goodkit-images

# ── AI Photo Assist (Anthropic) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Optional — degrades gracefully if missing

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_KEY=...                         # Secret key for /admin/* routes

# ── Detour Integration ────────────────────────────────────────────────────────
DETOUR_API_URL=https://detourdeliver.com  # Detour job posting endpoint
GOODKIT_API_KEY=...                       # Shared secret with Detour

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=https://good-kit.com
DB_PATH=./goodkit.db
UPLOAD_DIR=./uploads
